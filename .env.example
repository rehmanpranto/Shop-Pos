# Copy this file to .env and fill in real values. Never commit .env.

# Neon pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Where the app is served from. Needed on your own computer only; leave it out on Vercel.
NEXTAUTH_URL="http://localhost:3000"

# Long random strings. Generate each with: openssl rand -base64 32
NEXTAUTH_SECRET=""
BOOTSTRAP_SETUP_KEY=""

# Optional: needed only to email invoices
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
